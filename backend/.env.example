# Configuración del Backend (JavaMaster secure-executor)
# NOTA DE SEGURIDAD (RN-SEG-02): Este backend endurece el proceso Node pero NO provee
# aislamiento de red ni de sistema de archivos a nivel de SO (requiere contenedor Docker/nsjail).
# Mantener SIN desplegar en producción y Render suspendido hasta contar con contenedor aislado.

# Puerto del servidor
PORT=3000

# Orígenes permitidos por CORS (separados por comas, nunca '*')
ALLOWED_ORIGINS=https://java.belencalvo.me,http://localhost:8000,http://127.0.0.1:8000

# Límites de ejecución y recursos
TIMEOUT=5000
MAX_OUTPUT=10000
JAVA_MAX_MEMORY=64m
MAX_CONCURRENT=2

# Límite de tasa por IP (rate-limit)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
